{
  "name": "praxis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "python3 scripts/dev.py",
    "build": ".venv/bin/python scripts/build.py",
    "test": ".venv/bin/python -m pytest tests -q && npm run test --workspace apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm test && npm run build"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.2",
    "supabase": "3.0.0"
  }
}
