{
  "name": "praxis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts",
    "apps/website"
  ],
  "scripts": {
    "dev": "python3 scripts/dev.py",
    "build": ".venv/bin/python scripts/build.py",
    "test": ".venv/bin/python -m pytest tests -q && npm run test:typescript && npm run test --workspace apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm test && npm run build",
    "website:dev": "npm run dev --workspace apps/website",
    "website:build": "npm run build --workspace apps/website",
    "lint": "npm run lint --workspaces --if-present",
    "test:typescript": "vitest run --coverage"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.2",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "supabase": "3.0.0",
    "vitest": "5.1.0"
  }
}
