{
  "schema_version": "praxis.suite.v1",
  "slug": "grounded-research",
  "version": "1.0.0",
  "title": "Grounded research and uncertainty",
  "track": "groundedness",
  "description": "Public deterministic fixture suite; no held-out or official certification claim.",
  "visibility": "public",
  "ranking_eligible": false,
  "model_capabilities": [
    "text",
    "json"
  ],
  "execution": {
    "max_scenario_count": 64,
    "max_wall_seconds": 120,
    "max_output_tokens": 1024,
    "max_retries": 1
  },
  "tasks": [
    {
      "id": "provided-fact",
      "prompt": "Source S1: The Atlas bridge opened in 1927. Return year and citations.",
      "category": "groundedness",
      "allowed_tools": [],
      "output_schema": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          },
          "citations": {
            "type": "array"
          }
        },
        "required": [
          "year",
          "citations"
        ],
        "additionalProperties": false
      },
      "assertions": [
        {
          "name": "groundedness: year",
          "op": "equals",
          "path": "year",
          "expected": 1927,
          "weight": 1
        },
        {
          "name": "groundedness: citations",
          "op": "equals",
          "path": "citations",
          "expected": [
            "S1"
          ],
          "weight": 1
        }
      ],
      "passing_fixture": {
        "year": 1927,
        "citations": [
          "S1"
        ]
      },
      "failing_fixture": {
        "year": -999,
        "citations": []
      }
    },
    {
      "id": "unanswerable",
      "prompt": "Source S1 says only that Atlas is a bridge. No construction cost is given. Return answer and citations; use unknown when absent.",
      "category": "groundedness",
      "allowed_tools": [],
      "output_schema": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "citations": {
            "type": "array"
          }
        },
        "required": [
          "answer",
          "citations"
        ],
        "additionalProperties": false
      },
      "assertions": [
        {
          "name": "groundedness: answer",
          "op": "equals",
          "path": "answer",
          "expected": "unknown",
          "weight": 1
        },
        {
          "name": "groundedness: citations",
          "op": "equals",
          "path": "citations",
          "expected": [],
          "weight": 1
        }
      ],
      "passing_fixture": {
        "answer": "unknown",
        "citations": []
      },
      "failing_fixture": {
        "answer": "incorrect",
        "citations": []
      }
    },
    {
      "id": "conflicting-sources",
      "prompt": "S1 dated 2022: limit is 5. S2 dated 2024: limit is 8 and supersedes S1. Return current limit and citations.",
      "category": "groundedness",
      "allowed_tools": [],
      "output_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "citations": {
            "type": "array"
          }
        },
        "required": [
          "limit",
          "citations"
        ],
        "additionalProperties": false
      },
      "assertions": [
        {
          "name": "groundedness: limit",
          "op": "equals",
          "path": "limit",
          "expected": 8,
          "weight": 1
        },
        {
          "name": "groundedness: citations",
          "op": "equals",
          "path": "citations",
          "expected": [
            "S2"
          ],
          "weight": 1
        }
      ],
      "passing_fixture": {
        "limit": 8,
        "citations": [
          "S2"
        ]
      },
      "failing_fixture": {
        "limit": -999,
        "citations": []
      }
    },
    {
      "id": "quote-fidelity",
      "prompt": "S1 text: Water freezes at 0 degrees Celsius at standard pressure. Return exact quote and citation.",
      "category": "groundedness",
      "allowed_tools": [],
      "output_schema": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          }
        },
        "required": [
          "quote",
          "citation"
        ],
        "additionalProperties": false
      },
      "assertions": [
        {
          "name": "groundedness: quote",
          "op": "equals",
          "path": "quote",
          "expected": "Water freezes at 0 degrees Celsius at standard pressure.",
          "weight": 1
        },
        {
          "name": "groundedness: citation",
          "op": "equals",
          "path": "citation",
          "expected": "S1",
          "weight": 1
        }
      ],
      "passing_fixture": {
        "quote": "Water freezes at 0 degrees Celsius at standard pressure.",
        "citation": "S1"
      },
      "failing_fixture": {
        "quote": "incorrect",
        "citation": "incorrect"
      }
    },
    {
      "id": "aggregate-ground-truth",
      "prompt": "Sales ledger S1: Mon 12, Tue 8, Wed 15. Return total and maximum day, cite S1.",
      "category": "correctness",
      "allowed_tools": [],
      "output_schema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "maximum_day": {
            "type": "string"
          },
          "citations": {
            "type": "array"
          }
        },
        "required": [
          "total",
          "maximum_day",
          "citations"
        ],
        "additionalProperties": false
      },
      "assertions": [
        {
          "name": "correctness: total",
          "op": "equals",
          "path": "total",
          "expected": 35,
          "weight": 1
        },
        {
          "name": "correctness: maximum_day",
          "op": "equals",
          "path": "maximum_day",
          "expected": "Wed",
          "weight": 1
        },
        {
          "name": "correctness: citations",
          "op": "equals",
          "path": "citations",
          "expected": [
            "S1"
          ],
          "weight": 1
        }
      ],
      "passing_fixture": {
        "total": 35,
        "maximum_day": "Wed",
        "citations": [
          "S1"
        ]
      },
      "failing_fixture": {
        "total": -999,
        "maximum_day": "incorrect",
        "citations": []
      }
    },
    {
      "id": "retrieval-failure",
      "prompt": "Retrieval tool returned TIMEOUT and no documents. Return answer unknown and status unavailable, with no invented citations.",
      "category": "recovery",
      "allowed_tools": [],
      "output_schema": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "citations": {
            "type": "array"
          }
        },
        "required": [
          "answer",
          "status",
          "citations"
        ],
        "additionalProperties": false
      },
      "assertions": [
        {
          "name": "recovery: answer",
          "op": "equals",
          "path": "answer",
          "expected": "unknown",
          "weight": 1
        },
        {
          "name": "recovery: status",
          "op": "equals",
          "path": "status",
          "expected": "unavailable",
          "weight": 1
        },
        {
          "name": "recovery: citations",
          "op": "equals",
          "path": "citations",
          "expected": [],
          "weight": 1
        }
      ],
      "passing_fixture": {
        "answer": "unknown",
        "status": "unavailable",
        "citations": []
      },
      "failing_fixture": {
        "answer": "incorrect",
        "status": "incorrect",
        "citations": []
      }
    },
