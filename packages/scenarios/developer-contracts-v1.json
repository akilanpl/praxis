{
  "schema_version": "praxis.suite.v1",
  "slug": "developer-contracts",
  "version": "1.0.0",
  "title": "Developer and application contracts",
  "track": "contracts",
  "description": "Public deterministic fixture suite; no held-out or official certification claim.",
  "visibility": "public",
  "ranking_eligible": false,
  "model_capabilities": [
    "text",
    "json"
  ],
  "execution": {
    "max_scenario_count": 64,
    "max_wall_seconds": 120,
    "max_output_tokens": 1024,
    "max_retries": 1
  },
  "tasks": [
    {
      "id": "repair-boundary",
      "prompt": "Function intended to return even numbers currently filters n%2==1. Return replacement condition and expected result for [-2,-1,0,1,2]. This tests code reasoning, not executable code.",
      "category": "code_reasoning",
      "allowed_tools": [],
      "output_schema": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string"
          },
          "result": {
            "type": "array"
          }
        },
        "required": [
          "condition",
          "result"
        ],
        "additionalProperties": false
      },
      "assertions": [
        {
          "name": "code_reasoning: condition",
          "op": "equals",
          "path": "condition",
          "expected": "n % 2 == 0",
          "weight": 1
        },
        {
          "name": "code_reasoning: result",
          "op": "equals",
          "path": "result",
          "expected": [
            -2,
            0,
            2
          ],
          "weight": 1
        }
      ],
      "passing_fixture": {
        "condition": "n % 2 == 0",
        "result": [
          -2,
          0,
          2
        ]
      },
      "failing_fixture": {
        "condition": "incorrect",
        "result": []
      }
    },
    {
      "id": "api-validation",
      "prompt": "POST /orders requires quantity positive integer. Body {quantity:0}. Return HTTP status and error field.",
      "category": "api_contract",
      "allowed_tools": [],
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "field": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "field"
        ],
        "additionalProperties": false
      },
      "assertions": [
        {
          "name": "api_contract: status",
          "op": "equals",
          "path": "status",
          "expected": 422,
          "weight": 1
        },
        {
          "name": "api_contract: field",
          "op": "equals",
          "path": "field",
          "expected": "quantity",
          "weight": 1
        }
      ],
      "passing_fixture": {
        "status": 422,
        "field": "quantity"
      },
      "failing_fixture": {
        "status": -999,
        "field": "incorrect"
      }
    },
    {
      "id": "api-idempotency",
      "prompt": "POST request with key K creates O1. Same key K replayed with same payload. Return created_count and order IDs.",
      "category": "api_contract",
      "allowed_tools": [],
      "output_schema": {
        "type": "object",
        "properties": {
          "created_count": {
            "type": "integer"
          },
          "orders": {
            "type": "array"
          }
        },
        "required": [
          "created_count",
          "orders"
        ],
        "additionalProperties": false
      },
      "assertions": [
        {
          "name": "api_contract: created_count",
          "op": "equals",
          "path": "created_count",
          "expected": 1,
          "weight": 1
        },
        {
          "name": "api_contract: orders",
          "op": "equals",
          "path": "orders",
          "expected": [
            "O1",
            "O1"
          ],
          "weight": 1
        }
      ],
      "passing_fixture": {
        "created_count": 1,
        "orders": [
          "O1",
          "O1"
        ]
      },
      "failing_fixture": {
        "created_count": -999,
        "orders": []
      }
    },
