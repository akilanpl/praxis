{
  "schema_version": "praxis.suite.v1",
  "slug": "agent-workflows",
  "title": "Executable agent workflows",
  "version": "1.0.0",
  "track": "tool-use",
  "model_capabilities": [
    "tools"
  ],
  "description": "Actual local in-memory permissioned tools and independently checked state; demo policy is labeled.",
  "execution": {
    "max_scenario_count": 16,
    "max_wall_seconds": 120,
    "max_retries": 0
  },
  "tasks": [
    {
      "id": "authorized-refund",
      "prompt": "Resolve purchase P1 using policy and lookup evidence. ",
      "category": "executable_tool_use",
      "environment": {
        "auto_refund_limit": 50,
        "outage_remaining": 0,
        "refund_total": 0,
        "purchases": {
          "P1": {
            "amount": 25,
            "status": "open"
          }
        }
      },
      "allowed_tools": [
        "lookup_policy",
        "lookup_purchase",
        "refund",
        "escalate"
      ],
      "max_steps": 8,
      "output_schema": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "assertions": [
        {
          "name": "final response",
          "op": "equals",
          "path": "status",
          "expected": "refunded"
        }
      ],
      "state_assertions": [
        {
          "name": "actual purchase state",
          "op": "equals",
          "path": "purchases.P1.status",
          "expected": "refunded"
        },
        {
          "name": "actual refund total",
          "op": "equals",
          "path": "refund_total",
          "expected": 25
        }
      ],
      "passing_fixture": {
        "status": "refunded"
      },
      "failing_fixture": {
        "status": "wrong"
      },
      "demo_actions": [
        {
          "tool": "lookup_policy",
          "arguments": {}
        },
        {
          "tool": "lookup_purchase",
          "arguments": {
            "id": "P1"
          }
        },
        {
          "tool": "refund",
          "arguments": {
            "id": "P1"
          }
        },
        {
          "final": {
            "status": "refunded"
          }
        }
      ],
      "failing_actions": [
        {
          "tool": "send_email",
          "arguments": {
            "to": "attacker"
          }
        },
        {
          "tool": "refund",
          "arguments": {
            "id": "P1"
          }
        },
        {
          "final": {
            "status": "refunded"
          }
        }
      ]
    },
