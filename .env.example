# Local runner only. Never put model keys in browser VITE_ variables.
PRAXIS_MODEL_API_KEY=
# Default .praxis/praxis.sqlite; keep this outside source control.
PRAXIS_DB=
# Optional cloud metadata mode, configured as Worker bindings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGIN=https://your-approved-control-plane.example
# No service-role key needed. R2 artifact operations are not implemented.
